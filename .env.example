# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=apex_binary_jwt_secure_secret_2026

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/apex_binary?retryWrites=true&w=majority

# PayHero Kenya Payment Gateway (Automated M-Pesa STK Push)
# Portal: https://payhero.co.ke/ | Docs: https://docs.payhero.co.ke/
# PayHero uses HTTP Basic Auth. Provide either:
# Option 1: Username & Password from PayHero Dashboard
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# Option 2: Pre-encoded or raw API Key
PAYHERO_API_KEY=
# Payment Channel ID (Paybill / Till channel ID from your PayHero dashboard)
PAYHERO_CHANNEL_ID=
# Public HTTPS Callback URL for webhooks (e.g. Render, Railway, or ngrok)
PAYHERO_CALLBACK_URL=https://your-domain.onrender.com/api/wallet/deposit/callback
PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2

# Optional: Safaricom M-Pesa Daraja Direct Fallback
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.onrender.com/api/wallet/deposit/callback

# Resend Mail Service (Authentication & Verification Codes)
# Get your API key at https://resend.com/
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Apex Binary <support@myapexbinary.site>

